{
  "name": "devduo-esaas-storefront",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:brand && tsc --noEmit && vite build",
    "preview": "vite preview --port 3100",
    "typecheck": "tsc --noEmit",
    "check:brand": "node scripts/check-brand.mjs",
    "lint": "tsc --noEmit && node scripts/check-colors.mjs && node scripts/check-brand.mjs",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/lora": "^5.1.0",
    "@fontsource-variable/manrope": "^5.1.0",
    "@fontsource-variable/nunito": "^5.1.0",
    "@fontsource-variable/playfair-display": "^5.1.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@fontsource/poppins": "^5.1.0",
    "html-to-image": "^1.11.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
